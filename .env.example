APP_NAME=Agentra-AI
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1

HOST=127.0.0.1
PORT=8000

# PostgreSQL Database Configuration
POSTGRES_USER=agentra
POSTGRES_PASSWORD=agentra_secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agentra_db

# SQLAlchemy Connection URL (psycopg v3 driver)
DATABASE_URL=postgresql+psycopg://agentra:agentra_secret@localhost:5432/agentra_db

# Database Connection Pool Settings
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# Machine Learning Prompt Injection Microservice
MODEL_PATH=ml-model/artifacts/prompt_injection_model.joblib
ML_SERVICE_ENABLED=true
ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_TIMEOUT_SECONDS=1.5
ML_PROBABILITY_THRESHOLD=0.65
ML_MARGIN_THRESHOLD=0.55

LOG_LEVEL=INFO

# Langfuse Observability & LLM Tracing
LANGFUSE_SECRET_KEY="sk-lf-your-secret-key"
LANGFUSE_PUBLIC_KEY="pk-lf-your-public-key"
LANGFUSE_BASE_URL="https://cloud.langfuse.com"
LANGFUSE_HOST="https://cloud.langfuse.com"
LANGFUSE_ENABLED=true

